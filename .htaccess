# Index par defaut du site.
DirectoryIndex index.php

# Empeche la negociation automatique de noms de fichiers d'entrer en conflit
# avec les routes propres gerees par mod_rewrite.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Protections des dossiers et fichiers sensibles.
    RewriteRule (^|/)\.git(/|$) - [F,L,NC]
    RewriteRule ^(config|vendor|logs)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|Readme\.txt)$ - [F,L,NC]

    # Redirections canoniques des anciennes URL demandees directement.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s+(/(?:[^?\s]+/)*)index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ %1 [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s+(/(?:[^?\s]+/)*)([A-Za-z0-9-]+)\.php(?:[?\s]) [NC]
    RewriteRule ^([A-Za-z0-9-]+)\.php$ %1%2 [R=301,L,NE]

    RewriteRule ^about/?$ a-propos [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} .+/$
    RewriteRule ^(.+)/$ $1 [R=301,L]

    # Les fichiers et dossiers physiques conservent leur fonctionnement normal.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Routes publiques vers les dossiers autorises.
    RewriteRule ^(.+/)?assets/(.+)$ assets/$2 [L]
    RewriteRule ^(.+/)?forms/(.+)$ forms/$2 [L]

    # Route generique vers un fichier PHP existant a la racine.
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([A-Za-z0-9-]+)$ $1.php [L,QSA]
</IfModule>

<IfModule LiteSpeed>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
</IfModule>
